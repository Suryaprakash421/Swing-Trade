# Copy to .env. Never commit .env or real credentials.
# Use at least 32 random hex characters; URL-safe values avoid DATABASE_URL escaping.
DB_PASSWORD=replace-with-a-long-random-hex-password
# For local npm commands only. Compose supplies its internal db hostname itself.
DATABASE_URL=postgresql://papertrade:replace-with-a-long-random-hex-password@127.0.0.1:5432/papertrade

# Set the exact external HTTPS origin in production, without a trailing slash.
APP_ORIGIN=http://localhost:3000
APP_PORT=3000
HOST=127.0.0.1
PORT=3000
# Local HTTP development requires false. Set true behind production HTTPS.
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
# Compose enables this when the local reverse proxy forwards requests.
TRUST_PROXY=false
NODE_ENV=development

# Yahoo is delayed/unofficial. No broker credentials are required for v1.
PRICE_PROVIDER=yahoo
POLL_INTERVAL_MS=20000

# Optional. Alerts remain off until a user-specific recipient is verified.
TELEGRAM_BOT_TOKEN=
