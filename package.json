{
  "name": "paperlane",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,engine,web \"npm:dev:api\" \"npm:dev:engine\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "dev:engine": "node --env-file-if-exists=.env --import tsx --watch apps/engine/src/index.ts",
    "dev:web": "npm run dev --workspace @paper/web",
    "start:api": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "start:engine": "node --env-file-if-exists=.env --import tsx apps/engine/src/index.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/migrate.ts",
    "build": "npm run typecheck && npm run build --workspace @paper/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "import:calendar": "node --env-file-if-exists=.env --import tsx scripts/import-calendar.ts",
    "import:instruments": "node --env-file-if-exists=.env --import tsx scripts/import-instruments.ts",
    "reset:password": "node --env-file-if-exists=.env --import tsx scripts/reset-password.ts",
    "dev:db": "node --import tsx scripts/dev-db.ts",
    "test:browser": "playwright test",
    "verify:local": "node --import tsx scripts/verify-local.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.8",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "lucide-react": "1.66.0",
    "pino": "10.4.0",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "embedded-postgres": "16.15.0-beta.19",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
